      "action_magnitude_before_clipping": 0.25,
      "tangential_error_zero_tolerance": 1e-12,
      "tangential_error_zero_tolerance_units": "m/s",
      "zero_error_rule": "if_abs_tangential_error_lte_tolerance_use_action_0_0",
      "cartesian_mapping": "u_x = -0.25 * sign(tangential_error) * e_t_x; u_y = -0.25 * sign(tangential_error) * e_t_y",
      "record_radial_component": true,
      "record_tangential_component": true,
