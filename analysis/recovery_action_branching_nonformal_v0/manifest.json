  "coordinate_convention": {
    "frame_id": "inertial_cartesian_2d",
    "state_vector_order": [
      "x",
      "y",
      "vx",
      "vy"
    ],
    "action_vector_order": [
      "action_x",
      "action_y"
    ],
    "position_vector": "r = (x, y)",
    "velocity_vector": "v = (vx, vy)",
    "position_norm": "r_norm = sqrt(x*x + y*y)",
    "velocity_norm": "v_norm = sqrt(vx*vx + vy*vy)",
    "radial_unit_vector": "e_r = r / r_norm",
    "positive_tangential_unit_vector": "e_t = (-e_r_y, e_r_x)",
    "positive_tangential_orientation": "counterclockwise_90_degree_rotation_of_e_r",
    "signed_tangential_speed": "v_t = dot(v, e_t)",
    "target_circular_speed": "use_the_same_target_circular_speed_as_the_active_phase35_rollout_context",
    "signed_tangential_error": "tangential_error = v_t - target_circular_speed",
    "sign_convention": {
      "positive": 1,
      "negative": -1,
      "zero": 0,
      "zero_tolerance": 1e-12,
      "zero_tolerance_units": "m/s",
      "rule": "positive_if_error_gt_tolerance_negative_if_error_lt_negative_tolerance_zero_otherwise"
    },
    "velocity_zero_tolerance": 1e-12,
    "velocity_zero_tolerance_units": "m/s",
    "invalid_evaluation_conditions": [
      "position_norm_is_zero",
      "position_or_velocity_contains_nonfinite_value",
      "derived_unit_vector_contains_nonfinite_value",
      "target_circular_speed_is_nonfinite",
      "action_contains_nonfinite_value"
    ]
  },
